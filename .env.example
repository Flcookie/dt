# Copy to .env and fill in your values. Never commit .env to git.
# Sensitive credentials override config.json / config_local.json

# Neo4j (optional - overrides config)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password

# SSH for controllers (optional)
# SSH_USERNAME=robot
# SSH_PASSWORD=your_ssh_password

# MQTT broker (optional)
# MQTT_BROKER_HOST=broker.hivemq.com
# MQTT_BROKER_PORT=1883

# API auth - if set, dashboard and API require X-API-Key header
# API_KEY=your_secret_api_key
